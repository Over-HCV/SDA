.github
.quarto

# De libs/ solo se necesita _comun/.
libs/quarto
libs/shiny
libs/shiny-live

# Generados: se reconstruyen, no se despliegan.
learn/docs
learn/outputs
learn/.build

# Herramientas de desarrollo, no de ejecución.
learn/R/pruebas
learn/R/mapa.R
